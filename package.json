{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "npm-run-all --parallel dev lint:watch test:watch",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --color --fix",
    "lint:watch": "npm-run-all --serial lint chokidar:lint",
    "chokidar:lint": "chokidar \"src/**/*.{js,jsx,ts,tsx}\" -c \"npm run lint\"",
    "lint:fsd": "steiger ./src",
    "typecheck": "tsc && tsc -p e2e",
    "test": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest --watch --project unit",
    "test:coverage": "vitest run --coverage",
    "preversion": "eslint . && npm run typecheck && npm run test:all",
    "release": "npm version -m \"chore(release): %s\"",
    "preview": "vite preview",
    "deploy": "./scripts/deploy.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^5.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.13.1",
    "terra-draw": "^1.37.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.6",
    "npm-run-all": "^4.1.5",
    "pg": "^8.23.1",
    "steiger": "^0.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5"
  }
}
